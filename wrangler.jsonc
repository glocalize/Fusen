{
	// Fusen — Cloudflare Workers 設定
	// bot が付けた静的判定版を、サーバー(Hono)+D1+静的アセットの構成へ修正。
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fusen",
	"account_id": "e3ea22aa8d4b2b6e8cc0fb1014d40f26",
	"main": "src/index.js",
	"compatibility_date": "2026-06-16",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// Basic認証付きステージングのプロキシ対応: ここに列挙したホストにだけ Authorization:Basic を付与する。
	// 資格情報(ユーザー名:パスワード)は secret 側で設定: npx wrangler secret put PROXY_BASIC_AUTH
	"vars": {
		"PROXY_BASIC_AUTH_HOSTS": "d1yq92omvlf4ph.cloudfront.net",
		"PROXY_SPA_HOSTS": "d1yq92omvlf4ph.cloudfront.net"
	},
	// public/ を静的アセットとして配信。run_worker_first=true で Worker を必ず先に通し、
	// 配信は Worker から env.ASSETS.fetch() で明示的に行う(/fsn-assets/* など)。
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// データストア(JSONファイルの置き換え)。database_id は↓のコマンドで発行して貼る:
	//   npx wrangler d1 create fusen-db
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fusen-db",
			"database_id": "f4627e51-1819-4164-874d-e2c43347f1ee",
			"migrations_dir": "migrations"
		}
	]
}
